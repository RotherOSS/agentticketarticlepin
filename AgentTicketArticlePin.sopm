<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="0.1">
    <Name>AgentTicketArticlePin</Name>
    <Version>0.0.0</Version>
    <Framework>11.0.x</Framework>
    <Vendor>Rother OSS GmbH</Vendor>
    <URL>https://otobo.io/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Pin Articles to show them at the top of the list.</Description>
    <Description Lang="de">Ermöglicht das anheften von Artikeln an den Anfang der Artikelliste.</Description>
    <Filelist>
        <File Permission="660" Location="Custom/Kernel/Modules/AgentTicketZoom.pm" />
		<File Permission="660" Location="Custom/Kernel/Output/HTML/ArticleAction/ArticlePin.pm" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/AgentTicketZoom.tt" />
		<File Permission="660" Location="Kernel/Modules/AgentTicketArticlePin.pm" />
		<File Permission="660" Location="Kernel/Config/Files/XML/ArticlePin.xml" />
		<File Permission="660" Location="var/httpd/htdocs/js/thirdparty/jquery-tablesorter-2.28.14/widget-staticRow.min.js" />
		<File Permission="660" Location="var/httpd/htdocs/js/Core.Agent.ArticlePin.js" />
		<File Permission="660" Location="var/httpd/htdocs/js/Core.UI.Table.Sort.js" />
		<File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/css/Core.Agent.ArticlePin.css" />
    </Filelist>
</otobo_package>
